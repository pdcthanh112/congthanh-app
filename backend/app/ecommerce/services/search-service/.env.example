HTTP_ADDR=:5013
GRPC_ADDR=:9098
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=products
# Elastic Cloud: dùng API key (ưu tiên) hoặc user/password
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Trống = không cập nhật chỉ mục từ ecommerce.product.events
KAFKA_BROKERS=localhost:29092
# Xác thực JWT: chọn một trong hai. Bỏ trống cả hai thì service không khởi động,
# trừ khi đặt AUTH_DISABLED=true (chỉ dùng khi dev/test).
JWT_JWKS_URL=
JWT_SECRET=
JWT_ISSUER=
AUTH_DISABLED=false
LOG_FORMAT=text
LOG_LEVEL=info
