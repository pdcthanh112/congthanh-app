{
  "name": "@ecommerce/storefront-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BFF cho web/app khách hàng: subgraph sở hữu Product, giỏ hàng, đặt hàng; gom gRPC/REST các service Java/Go",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps --import @ecommerce/platform/telemetry dist/main.js",
    "schema:emit": "node dist/emit-schema.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@ecommerce/clients": "0.1.0",
    "@ecommerce/platform": "0.1.0",
    "@ecommerce/proto": "0.1.0",
    "@ecommerce/shared": "0.1.0",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.15.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
