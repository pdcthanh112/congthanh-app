HTTP_PORT=5026
# asyncpg URL (postgresql://...). Bảng nằm trong schema DB_SCHEMA, migration tự chạy khi khởi động.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/CongThanhApp-Ecommerce
DB_SCHEMA=fraud
REDIS_URL=redis://localhost:6379/6
# Bỏ trống = không dựng lịch sử khách từ event (các luật theo lịch sử luôn bằng 0).
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP=fraud-service
# Điểm >= REVIEW_AT → duyệt tay, >= REJECT_AT → từ chối.
REVIEW_AT=50
REJECT_AT=80
# Keycloak: JWT_JWKS_URL=http://localhost:8180/realms/congthanhapp/protocol/openid-connect/certs
# Bỏ trống = tắt xác thực (dev, dùng header X-User-Id).
JWT_JWKS_URL=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
