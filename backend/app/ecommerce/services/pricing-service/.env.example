HTTP_ADDR=:5025
GRPC_ADDR=:9099
DATABASE_URL=postgres://postgres:123456@localhost:5432/CongThanhApp-Ecommerce?sslmode=disable
DB_SCHEMA=pricing
KAFKA_BROKERS=localhost:29092
# Cache giá (Redis). Bỏ trống = không cache.
REDIS_URL=redis://localhost:6379/2
# Chu kỳ kích hoạt / kết thúc đợt sale hẹn giờ.
SCHEDULER_INTERVAL=15s
# Xác thực JWT: chọn một trong hai. Bỏ trống cả hai = tắt xác thực (chỉ dùng khi dev).
JWT_JWKS_URL=
JWT_SECRET=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
