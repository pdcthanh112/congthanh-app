HTTP_PORT=5028
# asyncpg URL. Bảng nằm trong schema DB_SCHEMA, migration tự chạy khi khởi động.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/CongThanhApp-Ecommerce
DB_SCHEMA=recommendation
# Bỏ trống = không học từ event (chỉ còn sự kiện VIEW/CART gửi qua API).
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP=recommendation-service
# Cần extension pgvector (image pgvector/pgvector trong docker-compose). false = chỉ mua kèm + xu hướng.
VECTOR_ENABLED=true
# hashing (không cần model) | ollama (embedding ngữ nghĩa, ví dụ bge-m3 dim 1024)
EMBEDDINGS_PROVIDER=hashing
EMBEDDING_DIM=256
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
MIN_SUPPORT=1
REBUILD_INTERVAL_SECONDS=21600
JWT_JWKS_URL=
JWT_ISSUER=
LOG_FORMAT=text
LOG_LEVEL=info
