{
  "name": "@ecommerce/message-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat khách hàng ↔ người bán / bộ phận hỗ trợ: GraphQL subgraph + subscription realtime qua Redis",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps --import @ecommerce/platform/telemetry dist/main.js",
    "migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "schema:emit": "node dist/emit-schema.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@ecommerce/platform": "0.1.0",
    "@ecommerce/proto": "0.1.0",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/graphql": "^14.2.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.4",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
