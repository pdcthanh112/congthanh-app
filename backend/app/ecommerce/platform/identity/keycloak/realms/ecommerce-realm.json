{
  "realm": "ecommerce",
  "enabled": true,
  "displayName": "CongThanh E-commerce",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Khách mua hàng"
      },
      {
        "name": "SELLER",
        "description": "Người bán"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị backoffice"
      },
      {
        "name": "SUPPORT",
        "description": "Chăm sóc khách hàng"
      }
    ]
  },
  "defaultRoles": [
    "CUSTOMER"
  ],
  "clientScopes": [
    {
      "name": "roles-claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "commerce:read",
      "description": "Cho trợ lý AI xem sản phẩm, giỏ hàng và đơn hàng của bạn",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Cho trợ lý AI xem sản phẩm, giỏ hàng và đơn hàng của bạn"
      },
      "protocolMappers": [
        {
          "name": "audience commerce-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "commerce-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "commerce:cart",
      "description": "Cho trợ lý AI thêm, sửa, xoá hàng trong giỏ của bạn",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Cho trợ lý AI thêm, sửa, xoá hàng trong giỏ của bạn"
      },
      "protocolMappers": [
        {
          "name": "audience commerce-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "commerce-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "commerce:orders.cancel",
      "description": "Cho trợ lý AI huỷ đơn hàng của bạn (sau khi bạn xác nhận)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Cho trợ lý AI huỷ đơn hàng của bạn (sau khi bạn xác nhận)"
      },
      "protocolMappers": [
        {
          "name": "audience commerce-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "commerce-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "apisix-gateway",
      "name": "API gateway (bearer only)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_GATEWAY_SECRET}",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "roles-claim"
      ]
    },
    {
      "clientId": "storefront-web",
      "name": "Storefront (Next.js)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://shop.congthanh.vn/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "roles-claim",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "backoffice-web",
      "name": "Backoffice",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*",
        "https://admin.congthanh.vn/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "roles-claim",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "order-service",
      "name": "Service account (client credentials) cho saga",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles-claim"
      ]
    },
    {
      "clientId": "notification-service",
      "name": "Service account: đọc email/SĐT người dùng để gửi thông báo",
      "enabled": true,
      "publicClient": false,
      "secret": "${NOTIFICATION_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles-claim"
      ]
    },
    {
      "clientId": "dev-cli",
      "name": "CHỈ LOCAL: lấy token bằng username/password (make token)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "roles-claim",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "commerce:read",
        "commerce:cart",
        "commerce:orders.cancel"
      ]
    },
    {
      "clientId": "commerce-mcp-agent",
      "name": "AI agent qua MCP (Claude Desktop, IDE...): người dùng tự chọn quyền trên màn hình consent",
      "enabled": true,
      "publicClient": true,
      "consentRequired": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://claude.ai/api/mcp/auth_callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "roles-claim"
      ],
      "optionalClientScopes": [
        "commerce:read",
        "commerce:cart",
        "commerce:orders.cancel"
      ]
    }
  ],
  "users": [
    {
      "username": "admin@congthanh.vn",
      "email": "admin@congthanh.vn",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Local",
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": true
        }
      ]
    },
    {
      "username": "customer@congthanh.vn",
      "email": "customer@congthanh.vn",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Khach",
      "lastName": "Local",
      "realmRoles": [
        "CUSTOMER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-notification-service",
      "enabled": true,
      "serviceAccountClientId": "notification-service",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
